{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/web/src/*"]
    }
  },
  "include": ["packages/*/src", "apps/*/src", "*.config.*"],
  "exclude": ["node_modules", "**/dist", "**/.next", "**/out"]
}
