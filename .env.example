# Supabase (локальный или облачный проект)
# VITE_* — попадают в браузерный бандл apps/web (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Только серверная сторона (бот, edge-функции). НЕ класть в браузер!
SUPABASE_SERVICE_ROLE_KEY=

# Telegram-бот (apps/bot)
TELEGRAM_BOT_TOKEN=

# Upstash Redis (сессии бота)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
